# Required
DATABASE_URL=postgresql+asyncpg://digitalailabindia:devpassword@localhost:5432/digitalailabindia
TEST_DATABASE_URL=postgresql+asyncpg://digitalailabindia:devpassword@localhost:5432/test_digitalailabindia
REDIS_URL=redis://localhost:6379/0

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars-replace-this
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# HuggingFace
HF_TOKEN=hf_your_token_here

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=digitalailabindia
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1

# App config
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_AUTHENTICATED=60

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Fine-tuning limits
MAX_CONCURRENT_JOBS_PER_USER=3
MAX_DATASET_SIZE_MB=500
